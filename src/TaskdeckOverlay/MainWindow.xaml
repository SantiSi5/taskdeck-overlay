<Window x:Class="TaskdeckOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="taskdeck-overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        StateChanged="Window_StateChanged"
        IsVisibleChanged="Window_IsVisibleChanged">

    <Border Background="#CC12161C" CornerRadius="8" Padding="12,8">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Opacity: more" Click="OpacityUp_Click" />
                <MenuItem Header="Opacity: less" Click="OpacityDown_Click" />
                <Separator />
                <MenuItem Header="Close" Click="Close_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <StackPanel>
            <TextBlock x:Name="CpuText" Foreground="#E6EDF3" FontFamily="Consolas" FontSize="13" Text="CPU  --%" />
            <TextBlock x:Name="RamText" Foreground="#E6EDF3" FontFamily="Consolas" FontSize="13" Text="RAM  --%" Margin="0,4,0,0" />
        </StackPanel>
    </Border>
</Window>
