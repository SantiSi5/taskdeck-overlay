{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47600/event",
            "headers": {
              "Authorization": "Bearer $TASKDECK_TOKEN"
            },
            "allowedEnvVars": [
              "TASKDECK_TOKEN"
            ],
            "timeout": 2
          }
        ]
